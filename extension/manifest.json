{
  "manifest_version": 3,
  "name": "CyberShield Site Check",
  "version": "1.0.0",
  "description": "Pause website navigation so you can review it before continuing.",
  "icons": {
    "16": "icons/cybershield-16.png",
    "32": "icons/cybershield-32.png",
    "48": "icons/cybershield-48.png",
    "128": "icons/cybershield-128.png"
  },
  "permissions": ["storage", "webNavigation", "tabs"],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "CyberShield protection",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cybershield-16.png",
      "32": "icons/cybershield-32.png",
      "48": "icons/cybershield-48.png"
    }
  },
  "options_page": "options.html"
}
